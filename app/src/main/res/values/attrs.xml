<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MaxHeightScrollView">
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>
    <declare-styleable name="Indicator">
        <attr name="layout_margin" format="dimension"/>
        <attr name="layout_marginTop" format="dimension"/>
        <attr name="layout_marginBottom" format="dimension"/>
        <attr name="layout_marginLeft" format="dimension"/>
        <attr name="layout_marginRight" format="dimension"/>
        <attr name="view_pager" format="reference"/>
        <attr name="active_color" format="color"/>
        <attr name="inactive_color" format="color"/>
        <attr name="indicator_height" format="dimension"/>
        <attr name="active_width" format="dimension"/>
        <attr name="inactive_width" format="dimension"/>
        <attr name="spacing" format="dimension"/>
        <attr name="corner_radiusX" format="dimension"/>
        <attr name="corner_radiusY" format="dimension"/>
        <attr name="active_opacity" format="float"/>
        <attr name="inactive_opacity" format="float"/>
    </declare-styleable>
    <declare-styleable name="AutoScrollViewPager">
        <attr name="period_millis" format="integer"/>
    </declare-styleable>

    <declare-styleable name="RadioButtonCustom">
        <attr name="text" format="string"/>
        <attr name="padding_left" format="dimension"/>
        <attr name="padding_right" format="dimension"/>
    </declare-styleable>

    <declare-styleable name="RoundCornerImageView">
        <attr name="corner_radius" format="float"/>
    </declare-styleable>



    <!--- style phone input-->
    <declare-styleable name="PhoneInputView">
        <attr name="title" format="string"/>
        <attr name="hint" format="string"/>
    </declare-styleable>

    <attr name="fontType" format="enum">
        <enum name="thin" value="1"/>
        <enum name="extra_light" value="2"/>
        <enum name="light" value="3"/>
        <enum name="normal" value="4"/>
        <enum name="medium" value="5"/>
        <enum name="semi_bold" value="6"/>
        <enum name="bold" value="7"/>
        <enum name="extra_bold" value="8"/>
        <enum name="black" value="9"/>
        <enum name="italic" value="10"/>
        <enum name="semi_bold_italic" value="11"/>
        <enum name="bold_italic" value="12"/>
    </attr>

    <declare-styleable name="TextViewEx">
        <attr name="fontType"/>
        <attr name="rounded_radius" format="dimension"/>
    </declare-styleable>

    <declare-styleable name="EditTextEx">
        <attr name="fontType"/>
    </declare-styleable>

    <declare-styleable name="ButtonEx">
        <attr name="fontType"/>
    </declare-styleable>

</resources>