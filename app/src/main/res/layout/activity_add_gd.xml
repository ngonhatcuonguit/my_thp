<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/acb_gray_background">

        <include
            android:id="@+id/lo_app_bar"
            layout="@layout/layout_acb_app_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <carbon.widget.TextView
            android:id="@+id/tv_type_gd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:padding="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            android:text="Chọn loại giao dịch"
            android:gravity="center"
            android:textSize="15sp"
            app:layout_constraintTop_toBottomOf="@id/lo_app_bar"
            app:layout_constraintEnd_toStartOf="@+id/tv_time"
            app:layout_constraintStart_toStartOf="parent" />

        <carbon.widget.TextView
            android:id="@+id/tv_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Chọn ngày giờ gd"
            android:gravity="center"
            android:textSize="15sp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toTopOf="@+id/tv_type_gd"
            app:layout_constraintBottom_toBottomOf="@+id/tv_type_gd"
            app:layout_constraintStart_toEndOf="@+id/tv_type_gd"
            app:layout_constraintEnd_toEndOf="parent" />

        <include
            android:id="@+id/edt_so_tien"
            layout="@layout/item_edit_text_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/edt_noi_dung"
            layout="@layout/item_big_edittext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="18dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edt_so_tien" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>