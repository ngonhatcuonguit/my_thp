<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="sheet"
            type="com.cuongngo.core_project.data.database.roomdb.entity.Sheet" />
    </data>
    <com.thelumiereguy.neumorphicview.views.NeumorphicCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="-16dp"
        android:background="#F8F8F8"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:cardRadius="8"
        app:enableShadow="true"
        app:enableStroke="true"
        app:enable_preview="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:neu_backgroundColor="#F8F8F8"
        app:shadowColor="#EDEDED"
        app:shadowDx="0dp"
        app:shadowDy="3dp"
        app:shadowRadius="8dp"
        app:stroke_color="#F1F4F6"
        app:stroke_width="1dp">

            <carbon.widget.ConstraintLayout
                android:id="@+id/card_request"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_white_radius_8"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="12dp"
                app:layout_constraintDimensionRatio="W,80:177"
                app:carbon_cornerRadius="6dp">

                <com.cuongngo.core_project.common.view.view_ex.TextViewEx
                    android:id="@+id/tv_request_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:textColor="@color/gray_36"
                    android:textSize="12sp"
                    android:paddingVertical="3dp"
                    android:gravity="center_vertical"
                    android:text="@{sheet.formName}"
                    app:layout_constraintEnd_toStartOf="@id/tv_status"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Mã yêu cầu: 123456" />

                <com.cuongngo.core_project.common.view.view_ex.TextViewEx
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_label_item_status"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="26/126"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="@id/tv_request_code"
                    app:layout_constraintBottom_toBottomOf="@id/tv_request_code"
                    app:layout_constraintStart_toEndOf="@id/tv_request_code"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/view_space"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="5dp"
                    android:background="@color/gray_A6"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_request_code" />

                <com.cuongngo.core_project.common.view.view_ex.TextViewEx
                    android:id="@+id/tv_request_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginVertical="8dp"
                    android:text="@{sheet.name}"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:lines="2"
                    android:maxLines="2"
                    android:gravity="center"
                    android:paddingBottom="10dp"
                    style="@style/TextViewEx.BodyMedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view_space"
                    tools:text="Giấy ra cổng - IT - Ngô Nhật Cường - 43950 - Ngày 24/06/2024" />

            </carbon.widget.ConstraintLayout>

    </com.thelumiereguy.neumorphicview.views.NeumorphicCardView>

</layout>