<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <com.cuongngo.core_project.common.view.view_ex.TextViewEx
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mã số nhân viên"
            android:textColor="@color/gray_62"
            android:textSize="14sp"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <com.cuongngo.core_project.common.view.view_ex.EditTextEx
            android:id="@+id/edt_value"
            style="@style/EditTextEx.SubtitleMedium"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/shape_gray_f7_radius8_stroke"
            android:ems="10"
            android:gravity="center_vertical|start"
            android:inputType="text|textNoSuggestions"
            android:lineSpacingExtra="8sp"
            android:overScrollMode="always"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarFadeDuration="0"
            android:scrollbarStyle="insideInset"
            android:scrollbars="vertical"
            android:hint="Nhập mã số nhân viên"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_99"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.cuongngo.core_project.common.view.view_ex.TextViewEx
            android:id="@+id/tv_validate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="2dp"
            android:textColor="@color/text_color_validate_red"
            android:textSize="14sp"
            android:visibility="gone"
            app:fontType="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edt_value" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>