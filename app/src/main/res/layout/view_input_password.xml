<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mật khẩu"
            android:textColor="@color/gray_62"
            android:textSize="15sp"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

<!--        <androidx.appcompat.widget.AppCompatImageView-->
<!--            android:id="@+id/iv_show_hide_password"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="18dp"-->
<!--            android:layout_marginEnd="5dp"-->
<!--            app:srcCompat="@drawable/ic_hide_pass"-->
<!--            android:tint="@color/black_1c"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintTop_toTopOf="@+id/tv_title"-->
<!--            app:layout_constraintBottom_toBottomOf="@id/tv_title"-->
<!--            />-->

        <com.cuongngo.my_thp.common.view.view_ex.EditTextEx
            android:id="@+id/edt_password"
            style="@style/EditTextEx.SingleLine"
            app:fontType="normal"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/shape_input_radius_12"
            android:gravity="center_vertical"
            android:inputType="textPassword"
            android:lines="1"
            android:singleLine="true"
            android:maxLength="30"
            android:paddingHorizontal="16dp"
            android:hint="Nhập mật khẩu"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_62"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
            android:id="@+id/tv_validate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="2dp"
            android:textColor="@color/text_color_validate_red"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible"
            app:fontType="normal"
            tools:text="hahahahahaha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edt_password" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>