<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="18dp">

    <carbon.widget.ConstraintLayout
        android:id="@+id/cl_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/acb_gray_background"
        android:paddingHorizontal="5dp"
        android:paddingVertical="3dp"
        app:carbon_cornerRadius="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_gd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_arrow_up" />

    </carbon.widget.ConstraintLayout>

    <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
        android:id="@+id/tvTransactionTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="16:20"
        android:textColor="@color/black_1c"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/cl_image"
        app:layout_constraintStart_toEndOf="@id/cl_image"
        app:layout_constraintTop_toTopOf="@id/cl_image" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+1 VND"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        android:lineSpacingExtra="6sp"
        app:layout_constraintBottom_toBottomOf="@id/cl_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cl_image" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvNameUser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Chuyen tien"
        app:textAllCaps="true"
        android:textColor="@color/black_1c"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="visible"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/cl_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Chuyen tien"
        app:textAllCaps="true"
        android:textColor="#444849"
        android:textSize="13sp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/tvNameUser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>