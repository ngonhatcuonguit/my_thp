<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
        android:id="@+id/tv_bottom_note"
        style="@style/TextViewEx.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:text="Chú ý: Bottom Note Content Here"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
        android:id="@+id/tv_left_sign_title"
        style="@style/TextViewEx.BodyMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="39dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="16dp"
        android:text="Left Sign"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_bottom_note" />

    <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
        android:id="@+id/tv_left_sign_subtitle"
        style="@style/TextViewEx.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="2dp"
        android:text="Ký và ghi rõ họ tên"
        android:textColor="@color/gray_36"
        app:layout_constraintEnd_toEndOf="@id/tv_left_sign_title"
        app:layout_constraintStart_toStartOf="@id/tv_left_sign_title"
        app:layout_constraintTop_toBottomOf="@id/tv_left_sign_title" />

    <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
        android:id="@+id/tv_right_sign_title"
        style="@style/TextViewEx.BodyMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="39dp"
        android:text="Right Sign"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_bottom_note" />

    <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
        android:id="@+id/tv_right_sign_subtitle"
        style="@style/TextViewEx.BodySmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="2dp"
        android:text="Ký và ghi rõ họ tên"
        android:textColor="@color/gray_36"
        app:layout_constraintEnd_toEndOf="@id/tv_right_sign_title"
        app:layout_constraintStart_toStartOf="@id/tv_right_sign_title"
        app:layout_constraintTop_toBottomOf="@id/tv_right_sign_title" />


</androidx.constraintlayout.widget.ConstraintLayout>