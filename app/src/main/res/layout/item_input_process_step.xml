<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
            android:id="@+id/tv_title_step"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Leader"
            android:layout_marginTop="12dp"
            android:textColor="@color/gray_62"
            android:textSize="15sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_user_profile_circle"
            android:drawablePadding="8dp"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_duration_step"
            app:layout_constraintTop_toTopOf="parent"/>

        <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
            android:id="@+id/tv_duration_step"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="120 phut"
            android:textColor="@color/gray_62"
            android:textSize="14sp"
            android:textAlignment="textEnd"
            android:textStyle="normal"
            android:drawableStart="@drawable/ic_clock"
            android:drawablePadding="5dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="@id/tv_title_step"
            app:layout_constraintBottom_toBottomOf="@id/tv_title_step"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
            android:id="@+id/tv_hint_step"
            style="@style/TextViewEx.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/shape_gray_f7_radius8_stroke"
            android:gravity="center_vertical|start"
            android:text="Nhập mã số nhân viên"
            android:lineSpacingExtra="8sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/gray_99"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title_step" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_list_user_step"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginHorizontal="10dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:orientation="horizontal"
            app:spanCount="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_user_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_hint_step"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tv_hint_step" />

        <com.cuongngo.my_thp.common.view.view_ex.TextViewEx
            android:id="@+id/tv_validate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_color_validate_red"
            android:textSize="14sp"
            android:visibility="gone"
            app:fontType="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_hint_step" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>