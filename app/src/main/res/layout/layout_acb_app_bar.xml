<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_app_bar"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:layout_width="10dp"
            android:layout_height="20dp"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="@id/cl_filter"
            app:layout_constraintTop_toTopOf="@id/cl_filter"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_back_acb" />


        <carbon.widget.ConstraintLayout
            android:id="@+id/cl_filter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="8dp"
            app:carbon_cornerRadius="30dp"
            android:padding="6dp"
            android:background="@color/acb_gray_ff"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_filter"
                android:layout_width="24.3dp"
                android:layout_height="17.6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:srcCompat="@drawable/ic_acb_filter" />

        </carbon.widget.ConstraintLayout>

        <com.cuongngo.core_project.common.view.view_ex.TextViewEx
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Danh sách thẻ"
            android:textAlignment="center"
            android:textColor="@color/acb_primary_2nd"
            android:textSize="20sp"
            android:textStyle="bold"
            app:fontType="bold"
            app:layout_constraintBottom_toBottomOf="@id/cl_filter"
            app:layout_constraintEnd_toEndOf="@id/cl_filter"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>